default_platform(:tvos)

platform :tvos do
  desc "Description of what the lane does"
  lane :build_simulator do
    build_app(
      skip_package_ipa: true,
      skip_archive: true,
      destination: "platform=tvOS Simulator,name=Apple TV"
  )
  end

  lane :build_unsign_ipa do
    sh "cd .. && rm -rf Payload *.xcarchive *.ipa *.zip"
    build_app(
    destination: "generic/platform=tvOS",
    configuration: "Release",
    codesigning_identity:"",
    skip_codesigning: true,
    skip_package_ipa: true,
    archive_path: "App.xcarchive",
    # 固定 DerivedData 与依赖包目录，供 CI 缓存复用（依赖编译和下载不必每次从头来）
    derived_data_path: "build/DerivedData",
    cloned_source_packages_path: "build/SourcePackages",
    # 打包不需要格式化、dSYM 和索引
    xcargs: "SKIP_SWIFTFORMAT=YES DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    )
    FastlaneCore::CommandExecutor.execute(command: "cd .. && mv App.xcarchive/Products/Applications ./Payload")
    zip(
      path: "./Payload",
      output_path: "AchordTV"
    )
    sh "cd .. && mv AchordTV.zip AchordTV.ipa"
    sh "cd .. && rm -rf Payload *.xcarchive *.zip || true"
  end
end
